{
  "_meta": {
    "title": "Naming-Tradition Presets — European set",
    "purpose": "How real cultures named people, places, and houses: content (concept domains) + structure (patterns). Sound comes from the culture's own phonology, not from here.",
    "axes": "A tradition sets CONTENT (contentPolicy over concept-packs tags) and STRUCTURE (patterns + particles + toponymic generics). The culture supplies the SOUND. Independent choices.",
    "caveat": "Each preset EVOKES a documented naming practice; it does not define a people. All fields are editable.",
    "pattern_vocab": {
      "personal": ["single", "dithematic", "theophoric", "epithet"],
      "place": ["descriptive-generic", "feature-descriptive", "possessive-settlement", "theonymic-place", "single"],
      "house": ["gens", "clan-patronymic", "clan", "locative", "occupational", "founder-line", "patronymic"]
    },
    "generic_position": "Each toponymic generic is a prefix (Glen-, Llan-, Colonia-) or a suffix (-by, -ton, -fell)."
  },
